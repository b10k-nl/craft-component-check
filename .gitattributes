# Keep the distributed package to what a site actually needs.
# runner/ ships: the Craft command runs it with Node.

/tests           export-ignore
/runner/test     export-ignore
/docs            export-ignore
/.github         export-ignore
/phpunit.xml     export-ignore
/phpstan.neon    export-ignore
/package.json    export-ignore
/.gitattributes  export-ignore
/.gitignore      export-ignore
